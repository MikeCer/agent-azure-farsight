    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "Deployment environment name, for example dev, test, or prod."
      }
    },
    "collectorLocation": {
      "type": "string",
      "defaultValue": "italynorth",
      "metadata": {
        "description": "Primary collector/control-plane location."
      }
    },
    "agentLocation": {
      "type": "string",
      "defaultValue": "swedencentral",
      "metadata": {
        "description": "Azure SRE Agent/tool gateway location."
      }
    },
    "enablePublicIngress": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Allow public ingress for development and test environments."
      }
    },
    "enablePrivateEndpoints": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable private endpoint-capable topology. Detailed private endpoint modules are added during hardening."
      }
    },
    "enableApim": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable optional API Management front door."
      }
    },
    "enableDevEnrollmentApi": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable development certificate enrollment API path."
      }
    },
    "cosmosJobRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Cosmos DB job retention in days."
      }
    },
    "artifactRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Blob artifact retention in days."
      }
    },
    "logAnalyticsRetentionDays": {
      "type": "int",
      "defaultValue": 90,
      "metadata": {
        "description": "Log Analytics retention in days."
      }
    },
    "adminGroupObjectIds": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Admin group object IDs allowed to manage FarSight."
      }
    }
  },
  "variables": {
    "namePrefix": "[format('farsight-{0}', parameters('environmentName'))]",
    "tags": {
      "application": "agent-azure-farsight",
      "environment": "[parameters('environmentName')]",
      "managedBy": "azd-bicep"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('core-{0}', parameters('environmentName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
