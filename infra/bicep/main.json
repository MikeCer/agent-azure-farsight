          "cosmosJobRetentionDays": {
            "value": "[parameters('cosmosJobRetentionDays')]"
          },
          "artifactRetentionDays": {
            "value": "[parameters('artifactRetentionDays')]"
          },
          "logAnalyticsRetentionDays": {
            "value": "[parameters('logAnalyticsRetentionDays')]"
          },
          "enablePublicIngress": {
            "value": "[parameters('enablePublicIngress')]"
          },
          "enablePrivateEndpoints": {
            "value": "[parameters('enablePrivateEndpoints')]"
          },
          "enableApim": {
            "value": "[parameters('enableApim')]"
          },
          "enableDevEnrollmentApi": {
            "value": "[parameters('enableDevEnrollmentApi')]"
          },
          "adminGroupObjectIds": {
            "value": "[parameters('adminGroupObjectIds')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.44.1.10279",
              "templateHash": "15149578178590055430"
            }
          },
          "parameters": {
            "namePrefix": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            },
            "cosmosJobRetentionDays": {
              "type": "int"
            },
            "artifactRetentionDays": {
              "type": "int"
            },
            "logAnalyticsRetentionDays": {
              "type": "int"
            },
            "enablePublicIngress": {
              "type": "bool"
            },
            "enablePrivateEndpoints": {
              "type": "bool"
            },
            "enableApim": {
              "type": "bool"
            },
            "enableDevEnrollmentApi": {
              "type": "bool"
            },
            "adminGroupObjectIds": {
              "type": "array"
            }
          },
          "variables": {
            "normalizedPrefix": "[replace(toLower(parameters('namePrefix')), '-', '')]",
            "unique": "[take(uniqueString(resourceGroup().id, parameters('namePrefix')), 8)]",
            "storageAccountName": "[format('st{0}{1}', take(variables('normalizedPrefix'), 10), variables('unique'))]",
            "acrName": "[format('acr{0}{1}', take(variables('normalizedPrefix'), 16), variables('unique'))]",
            "keyVaultName": "[format('kv-{0}-{1}', take(variables('normalizedPrefix'), 8), variables('unique'))]",
            "appConfigName": "[format('appcs-{0}-{1}', parameters('namePrefix'), take(variables('unique'), 4))]",
            "workspaceName": "[format('law-{0}-{1}', parameters('namePrefix'), parameters('location'))]",
