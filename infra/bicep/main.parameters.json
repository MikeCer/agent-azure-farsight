{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "collectorLocation": {
      "value": "${AZURE_COLLECTOR_LOCATION=italynorth}"
    },
    "enablePublicIngress": {
      "value": "${FARSIGHT_ENABLE_PUBLIC_INGRESS=true}"
    },
    "enablePrivateEndpoints": {
      "value": "${FARSIGHT_ENABLE_PRIVATE_ENDPOINTS=false}"
    },
    "enableAcrTaskNetworkBypass": {
      "value": "${FARSIGHT_ENABLE_ACR_TASK_NETWORK_BYPASS=true}"
    },
    "acrFirewallAllowedIpRanges": {
      "value": [
        "${FARSIGHT_ACR_FIREWALL_ALLOWED_IP_RANGE_ITALY_NORTH=4.232.51.192/26}",
        "${FARSIGHT_ACR_FIREWALL_ALLOWED_IP_RANGE_SWEDEN_CENTRAL=172.160.222.128/26}"
      ]
    },
    "vnetAddressPrefix": {
      "value": "${FARSIGHT_VNET_ADDRESS_PREFIX=10.10.0.0/16}"
    },
    "containerAppsInfrastructureSubnetPrefix": {
      "value": "${FARSIGHT_CONTAINER_APPS_INFRASTRUCTURE_SUBNET_PREFIX=10.10.0.0/23}"
    },
    "privateEndpointSubnetPrefix": {
      "value": "${FARSIGHT_PRIVATE_ENDPOINT_SUBNET_PREFIX=10.10.2.0/24}"
    },
    "apimSubnetPrefix": {
      "value": "${FARSIGHT_APIM_SUBNET_PREFIX=10.10.3.0/24}"
    },
    "privateDnsZoneResourceIds": {
      "value": {
        "storageBlob": "${FARSIGHT_PRIVATE_DNS_ZONE_STORAGE_BLOB_RESOURCE_ID=}",
        "keyVault": "${FARSIGHT_PRIVATE_DNS_ZONE_KEY_VAULT_RESOURCE_ID=}",
        "containerRegistry": "${FARSIGHT_PRIVATE_DNS_ZONE_CONTAINER_REGISTRY_RESOURCE_ID=}",
        "cosmosSql": "${FARSIGHT_PRIVATE_DNS_ZONE_COSMOS_SQL_RESOURCE_ID=}",
        "serviceBus": "${FARSIGHT_PRIVATE_DNS_ZONE_SERVICE_BUS_RESOURCE_ID=}",
        "appConfiguration": "${FARSIGHT_PRIVATE_DNS_ZONE_APP_CONFIGURATION_RESOURCE_ID=}",
        "apiManagement": "${FARSIGHT_PRIVATE_DNS_ZONE_API_MANAGEMENT_RESOURCE_ID=}",
        "azureMonitor": "${FARSIGHT_PRIVATE_DNS_ZONE_AZURE_MONITOR_RESOURCE_ID=}",
        "logAnalyticsOms": "${FARSIGHT_PRIVATE_DNS_ZONE_LOG_ANALYTICS_OMS_RESOURCE_ID=}",
        "logAnalyticsOds": "${FARSIGHT_PRIVATE_DNS_ZONE_LOG_ANALYTICS_ODS_RESOURCE_ID=}",
        "azureMonitorAgentSvc": "${FARSIGHT_PRIVATE_DNS_ZONE_AZURE_MONITOR_AGENT_SVC_RESOURCE_ID=}",
        "containerAppsEnvironment": "${FARSIGHT_PRIVATE_DNS_ZONE_CONTAINER_APPS_ENVIRONMENT_RESOURCE_ID=}"
      }
    },
    "linkExistingPrivateDnsZones": {
      "value": "${FARSIGHT_LINK_EXISTING_PRIVATE_DNS_ZONES=true}"
    },
    "enableNatGateway": {
      "value": "${FARSIGHT_ENABLE_NAT_GATEWAY=false}"
    },
    "enableApim": {
      "value": "${FARSIGHT_ENABLE_APIM=false}"
    },
    "enableDevEnrollmentApi": {
      "value": "${FARSIGHT_ENABLE_DEV_ENROLLMENT_API=true}"
    },
    "cosmosJobRetentionDays": {
      "value": "${FARSIGHT_COSMOS_JOB_RETENTION_DAYS=30}"
    },
    "artifactRetentionDays": {
      "value": "${FARSIGHT_ARTIFACT_RETENTION_DAYS=30}"
    },
    "logAnalyticsRetentionDays": {
      "value": "${FARSIGHT_LOG_ANALYTICS_RETENTION_DAYS=90}"
    },
    "adminGroupObjectIds": {
      "value": []
    },
    "apiInternalAuthSecret": {
      "value": "${FARSIGHT_API_INTERNAL_AUTH_SECRET=}"
    },
    "enableAdminEasyAuth": {
      "value": "${FARSIGHT_ENABLE_ADMIN_EASY_AUTH=false}"
    },
    "adminAuthClientId": {
      "value": "${FARSIGHT_ADMIN_AUTH_CLIENT_ID=}"
    },
    "adminAuthClientSecret": {
      "value": "${FARSIGHT_ADMIN_AUTH_CLIENT_SECRET=}"
    },
    "adminAuthEncryptionSecret": {
      "value": "${FARSIGHT_ADMIN_AUTH_ENCRYPTION_SECRET=}"
    },
    "adminAuthIssuer": {
      "value": "${FARSIGHT_ADMIN_AUTH_ISSUER=}"
    },
    "adminAuthAllowedAudiences": {
      "value": [
        "${FARSIGHT_ADMIN_AUTH_ALLOWED_AUDIENCE=}"
      ]
    },
    "adminAuthTokenStoreSasUrlSettingName": {
      "value": "${FARSIGHT_ADMIN_AUTH_TOKEN_STORE_SAS_URL_SETTING_NAME=}"
    }
  }
}
