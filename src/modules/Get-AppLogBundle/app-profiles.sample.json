[
  {
    "appId": "default",
    "displayName": "Default application log profile",
    "comment": "Generic profile for applications that store plain-text logs in a known folder. Replace allowedLogRoots with the real application paths before production use.",
    "allowedLogRoots": [
      "C:\\ProgramData",
      "c:\\myapp"
    ],
    "defaultIncludeFilters": ["*.log", "*.txt", "*.jsonl", "*.ndjson"],
    "defaultExcludeFilters": [
      "*.dmp", "*.etl", "*.evtx", "*.bak", "*.old",
      "*secret*", "*token*", "*password*", "*credential*",
      "*private*key*", "*id_rsa*", "*pfx*", "*p12*"
    ],
    "maxBytes": 10485760,
    "maxFiles": 50,
    "allowRecursive": true,
    "maxDepth": 3,
    "allowBinaryFiles": false,
    "redactionProfiles": ["default", "strict"]
  }
]