{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.farsight.local/modules/Get-ConfigEvidence/input.schema.json",
  "title": "Get-ConfigEvidence input",
  "description": "Collects bounded read-only evidence from allowlisted configuration profiles.",
  "type": "object",
  "required": ["appId", "evidenceProfiles"],
  "properties": {
    "appId": { "type": "string", "minLength": 1 },
    "evidenceProfiles": {
      "type": "array",
      "items": { "type": "string", "enum": ["registry", "files", "environment"] },
      "minItems": 1,
      "maxItems": 5
    }
  },
  "additionalProperties": false
}
