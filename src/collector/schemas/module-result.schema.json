{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.farsight.local/collector/module-result.schema.json",
  "title": "FarSight module result envelope",
  "type": "object",
  "required": ["schemaVersion", "jobId", "deviceId", "correlationId", "module", "status", "startedAtUtc", "completedAtUtc", "summary", "findings", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "minLength": 1 },
    "status": { "enum": ["Succeeded", "Failed", "TimedOut", "Rejected"] },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "summary": { "type": "object" },
    "findings": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "nextSuggestedModules": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
